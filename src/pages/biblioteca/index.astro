---
// Hub de la biblioteca de equipos 3D: grilla filtrable por etapa (sin JS se ve completa).
import { getCollection } from 'astro:content';
import Base from '@mcco/web-kit/layouts/Base.astro';
import { loadSite } from '@mcco/web-kit/lib/site.mjs';
import Cabecera from '../../components/Cabecera.astro';
import '../../styles/theme.css';
import '../../styles/biblioteca.css';

const ETAPAS: Record<string, string> = { carguio: 'Carguío', transporte: 'Transporte', subterranea: 'Subterránea', chancado: 'Chancado', clasificacion: 'Clasificación', molienda: 'Molienda' };
const equipos = (await getCollection('equipos')).sort((a, b) => a.data.orden - b.data.orden);
const etapas = [...new Set(equipos.map((e) => e.data.etapa))];
const site = loadSite();
const jsonld = [{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Biblioteca de equipos 3D', url: new URL('/biblioteca/', site.domain).href, hasPart: equipos.map((e) => ({ '@type': 'WebPage', name: `${e.data.nombre} en 3D`, url: new URL(`/biblioteca/${e.id}`, site.domain).href })) }];
---
<Base title="Biblioteca de equipos mineros en 3D | 3D Ultra" description="Equipos mineros en 3D: camiones, palas y cargadores que modelamos para planificar mantenciones, animar procedimientos y capacitar." jsonld={jsonld} bodyClass="bib-pagina">
  <Fragment slot="head">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&display=swap" />
  </Fragment>
  <Cabecera actual="biblioteca" />
  <main>
    <section class="bib-hub-cabeza"><div class="bib-contenedor">
      <div class="bib-rotulo">Biblioteca de equipos</div>
      <h1>Equipos mineros en 3D</h1>
      <p class="bib-texto" style="margin-top:16px">Estos son algunos de los equipos que modelamos. Cada uno tiene su ficha con el modelo en 3D y lo que hacemos con él.</p>
    </div></section>
    <section class="bib-bloque" style="border-top:0;padding-top:0"><div class="bib-contenedor">
      <div class="bib-filtros" role="group" aria-label="Filtrar por etapa" hidden>
        <button type="button" data-etapa="" aria-pressed="true">Todos</button>
        {etapas.map((e) => <button type="button" data-etapa={e} aria-pressed="false">{ETAPAS[e]}</button>)}
      </div>
      <div class="bib-tarjetas">
        {equipos.map((e) => (
          <a class="bib-tarjeta" href={`/biblioteca/${e.id}`} data-etapa={e.data.etapa}>
            <span class="bib-franja"><img src={`/biblioteca/${e.id}/poster.webp`} alt={`Modelo 3D de referencia: ${e.data.nombre}`} width="1600" height="1000" loading="lazy" decoding="async" /></span>
            <span class="bib-info"><span class="bib-etapa">{ETAPAS[e.data.etapa]}</span><b>{e.data.nombre}</b><p>{e.data.bajada}</p></span>
          </a>
        ))}
      </div>
    </div></section>
    <section class="bib-bloque" id="contacto"><div class="bib-contenedor">
      <div class="bib-rotulo">Contacto</div>
      <h2 class="bib-titular">¿Su equipo no está en la lista?</h2>
      <p class="bib-texto">Modelamos el equipo que usted opera, con sus medidas reales. Escríbanos y le respondemos en menos de 24 horas hábiles.</p>
      <div class="bib-acciones"><a class="bib-btn bib-btn-blanco" href="/#contacto">Pedir una evaluación</a></div>
    </div></section>
  </main>
  {/* El script va dentro del layout: Astro lo emite donde se declara. */}
  <script>
    // Filtro por etapa: sin JS los botones quedan ocultos y se ven todos los equipos.
    const grupo = document.querySelector<HTMLElement>('.bib-filtros');
    if (grupo) {
      grupo.hidden = false;
      const botones = [...grupo.querySelectorAll<HTMLButtonElement>('button')];
      const tarjetas = [...document.querySelectorAll<HTMLElement>('.bib-tarjeta[data-etapa]')];
      grupo.addEventListener('click', (ev) => {
        const b = (ev.target as HTMLElement).closest('button');
        if (!b) return;
        const etapa = b.dataset.etapa ?? '';
        botones.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        tarjetas.forEach((t) => { t.hidden = etapa !== '' && t.dataset.etapa !== etapa; });
      });
    }
  </script>
</Base>
