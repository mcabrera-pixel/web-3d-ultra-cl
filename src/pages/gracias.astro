---
// Destino del formulario: functions/api/contact.js redirige aquí con 302 cuando el Worker acepta el lead.
// Hoy no hay medición de conversiones: GA4, Ads y beacon están vacíos en site.yaml y el Analytics del layout no
// emite nada. Si se configuran, la medición sale de ese único Analytics; no agregar eventos ni etiquetas aquí.
import Sitio from '../layouts/Sitio.astro';
import Bloque from '@mcco/web-kit/components/estandar/Bloque.astro';
import { loadSite } from '@mcco/web-kit/lib/site.mjs';
import '../styles/editorial.css';
const site = loadSite();
const wa = site.contact.whatsapp?.replace(/\D/g, '');
---
<Sitio title={`Gracias | ${site.name}`} description={`Recibimos tu solicitud en ${site.name}. Un ingeniero la revisa y te responde por correo o WhatsApp dentro de 24 horas hábiles.`} noindex={true}>
  <Bloque class="editorial" tono="claro">
    <h1 class="std-h1">Recibimos tu solicitud</h1>
    <p class="std-tagline">{site.contact.response_sla ?? 'Te respondemos en menos de 24 horas hábiles.'}</p>
    {wa && <p>¿Es urgente? <a href={`https://wa.me/${wa}`} rel="noopener">Escríbenos por WhatsApp</a>.</p>}
    <p><a class="std-pildora std-pildora--fantasma" href="/">Volver al inicio</a></p>
  </Bloque>
</Sitio>
