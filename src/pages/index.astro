---
import Sitio from '../layouts/Sitio.astro';
import InicioContenido from '../components/InicioContenido.astro';
import { loadSite } from '@mcco/web-kit/lib/site.mjs';
import '../styles/inicio.css';
const site = loadSite();
// SEO conservado.
const title = '3DUltra Arch & Ingeniería Soluciones de Ingeniería 4.0';
---
<Sitio title={title} description={site.description.trim()} organization={true} ogImage="/og.webp"
  alternates={[{ lang: 'es', href: '/' }, { lang: 'en', href: '/en/faq' }]}>
  <InicioContenido />
</Sitio>
