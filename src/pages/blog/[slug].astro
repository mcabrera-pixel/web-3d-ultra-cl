---
// Página de artículo: una ruta por entrada de la colección blog → /blog/<slug> (archivo <slug>.html).
// Va dentro de Sitio (Estandar del kit: navegación, sub-navegación, pie, favicon y enlace de salto del sitio). El
// artículo completo lo arma ArticuloBlog del kit: ruta, título, autor y fecha, cápsula, contenido, fuentes, FAQ (con su
// FAQPage), relacionados y Cta, con su BlogPosting y su BreadcrumbList. cabeceraArticulo entrega las props del <head>.
import Sitio from '../../layouts/Sitio.astro';
import Bloque from '@mcco/web-kit/components/estandar/Bloque.astro';
import ArticuloBlog from '@mcco/web-kit/components/ArticuloBlog.astro';
import { cabeceraArticulo } from '@mcco/web-kit/lib/articulo.mjs';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<Sitio {...cabeceraArticulo(post, Astro.url)}>
  <Bloque tono="claro">
    <ArticuloBlog post={post} claseTitulo="std-h1"><Content /></ArticuloBlog>
  </Bloque>
</Sitio>
